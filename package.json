{
  "name": "aewkan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint",
    "env:init": "node scripts/init-env.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "types:check": "node scripts/types-check.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "lessons:check": "node scripts/kit/verify-lessons.mjs docs/LESSONS.md --rulings docs/RULINGS.md",
    "verify": "node scripts/kit/verify-route-guards.mjs src/app && node scripts/kit/verify-portability.mjs && node scripts/types-check.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "browser-image-compression": "^2.0.2",
    "lucide-react": "^1.60.0",
    "maplibre-gl": "^6.15.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "promptpay-qr": "^0.5.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "stripe": "^23.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
