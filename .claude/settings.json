{
  "extraKnownMarketplaces": {
    "kp-marketplace": {
      "source": { "source": "github", "repo": "kpcrmv4/kp-supabase-nextjs" }
    }
  },
  "enabledPlugins": {
    "kp-supabase-nextjs@kp-marketplace": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/kit/guard-shell-writes.mjs\"" }
        ]
      }
    ]
  }
}
